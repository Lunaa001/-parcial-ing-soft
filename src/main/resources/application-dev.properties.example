# Plantilla del perfil "dev" (desarrollo local con PostgreSQL).
# Copiala como application-dev.properties (esta en .gitignore, no se sube) y completa tus valores.
# Activar con: SPRING_PROFILES_ACTIVE=dev
spring.application.name=IA-Perfume-Advisor

# Base de datos local
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/perfume_advisor}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:<tu-password-local>}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Permite que Flyway adopte un esquema local ya existente (creado antes por ddl-auto=update)
spring.flyway.baseline-on-migrate=true

server.port=8080
server.servlet.context-path=/

logging.level.root=INFO
logging.level.com.iaperfumeadvisor=DEBUG
logging.level.org.hibernate.SQL=DEBUG

# JWT: clave de al menos 32 caracteres (256 bits). Solo para desarrollo.
jwt.secret=${JWT_SECRET:<clave-de-desarrollo-de-32-caracteres-o-mas>}
jwt.expiration=86400000

# Admin inicial (solo se crea si la password no esta vacia)
admin.default.username=${ADMIN_USERNAME:admin}
admin.default.password=${ADMIN_PASSWORD:}
admin.default.email=${ADMIN_EMAIL:admin@ejemplo.com}

# Groq (nunca hardcodear la key: siempre via variable de entorno)
groq.api-key=${GROQ_API_KEY:}
groq.model=${GROQ_MODEL:groq/compound}
groq.fallback-model=${GROQ_FALLBACK_MODEL:openai/gpt-oss-120b}
groq.extraction-model=${GROQ_EXTRACTION_MODEL:openai/gpt-oss-20b}
groq.api-url=${GROQ_API_URL:https://api.groq.com/openai/v1}

# WhatsApp del negocio (formato internacional sin +, ej: 5491122334455)
whatsapp.business-number=${WHATSAPP_BUSINESS_NUMBER:}
