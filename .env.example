# =============================================================================
# Plantilla de variables de entorno. Copiala como .env (esta en .gitignore) y
# completa los valores. NUNCA subas el .env con valores reales.
#
# La usan:
#   - docker compose (env_file: .env) para levantar la app en local
#   - ScriptAz.java (gestor de Azure Container Apps: java ScriptAz.java)
#
# [OBLIGATORIA] = sin ella falla.  [OPCIONAL] = tiene un valor por defecto.
# =============================================================================


# -----------------------------------------------------------------------------
# APLICACION (Spring Boot)
# -----------------------------------------------------------------------------

# [OPCIONAL] Perfil de Spring. "cloud" = H2 en memoria (el de Azure y docker compose).
# "dev" = PostgreSQL local. docker-compose.yml ya lo fija en "cloud".
SPRING_PROFILES_ACTIVE=cloud

# [OBLIGATORIA] Clave para firmar los tokens JWT. Minimo 32 caracteres (256 bits).
# Generar una con: openssl rand -base64 48
JWT_SECRET=

# [OPCIONAL] Duracion del token en milisegundos. Por defecto 86400000 (24 horas).
JWT_EXPIRATION=86400000

# [OBLIGATORIA] API key de Groq (https://console.groq.com/keys). Sin ella el perfil cloud no arranca.
GROQ_API_KEY=

# [OPCIONAL] Modelos y URL de Groq. Descomentar solo para cambiar el valor por defecto
# (una variable vacia NO usa el default: queda en blanco y rompe la llamada).
# GROQ_MODEL=groq/compound
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# GROQ_EXTRACTION_MODEL=openai/gpt-oss-20b
# GROQ_API_URL=https://api.groq.com/openai/v1

# [OPCIONAL] Admin inicial. Si ADMIN_PASSWORD queda vacia, NO se crea el admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@ejemplo.com

# [OPCIONAL] Numero de WhatsApp del negocio para el link de pedido
# (formato internacional sin +, ej: 5491122334455). Vacio = sin link.
WHATSAPP_BUSINESS_NUMBER=

# [OPCIONAL] Carpeta de fotos subidas. En el contenedor ya vale /tmp/uploads (Dockerfile).
# UPLOAD_DIR=/tmp/uploads

# [OPCIONAL] Base PostgreSQL (solo perfiles por defecto y "dev"; el perfil cloud usa H2).
# Descomentar solo para cambiar el valor por defecto (vacia NO usa el default).
# DB_URL=jdbc:postgresql://localhost:5432/perfume_advisor
# DB_USER=postgres
# DB_PASSWORD=

# [OBLIGATORIAS solo en el perfil "prod"] Base PostgreSQL de produccion (por partes).
# DB_HOST=
# DB_PORT=5432
# DB_NAME=

# [OPCIONAL] API key de NVD para ./gradlew dependencyCheckAnalyze (auditoria de CVEs a mano).
# NVD_API_KEY=


# -----------------------------------------------------------------------------
# SCRIPTAZ.JAVA (gestor de Azure Container Apps)
# Las 4 credenciales salen de: az ad sp create-for-rbac (ver DEPLOY.md)
# -----------------------------------------------------------------------------

# [OBLIGATORIA] appId del Service Principal.
AZURE_CLIENT_ID=

# [OBLIGATORIA] password del Service Principal. Se muestra una sola vez al crearlo.
AZURE_CLIENT_SECRET=

# [OBLIGATORIA] tenant del Service Principal.
AZURE_TENANT_ID=

# [OBLIGATORIA] id de la suscripcion donde esta el resource group (az account show --query id -o tsv).
AZURE_SUBSCRIPTION_ID=

# [OPCIONAL] Infraestructura. Si quedan vacias, el script las lista con az y te deja elegir.
# El ACR existe solo mientras la app esta levantada (workflow "Levantar"); con todo apagado no hay ACR.
RESOURCE_GROUP=rg-perfume
ACR_NAME=
CONTAINERAPP_ENVIRONMENT=perfume-env
CONTAINERAPP_NAME=perfume-api

# [OPCIONAL] Imagen. Por defecto: parcial-ing-soft, v1.0.0, Dockerfile y "." (raiz del repo).
IMAGE_NAME=parcial-ing-soft
IMAGE_TAG=v1.0.0
DOCKERFILE_PATH=Dockerfile
BUILD_CONTEXT=.

# [OPCIONAL] Puerto donde escucha la app dentro del contenedor (ingress de Azure).
TARGET_PORT=8080

# [OPCIONAL] Recursos de la Container App (perfil minimo de Azure, sin GPU). Son los que usa
# hoy perfume-api; el deploy del script los vuelve a aplicar.
CPU=0.25
MEMORY=0.5Gi
MIN_REPLICAS=1
MAX_REPLICAS=1
